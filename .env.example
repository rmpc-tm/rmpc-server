# Database
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Openplanet
OPENPLANET_PLUGIN_SECRET=your_plugin_secret_here

# Signs the per-player page links. Required: without it every player page
# answers 404. Any long random string; changing it invalidates existing links.
PLAYER_LINK_SECRET=your_player_link_secret_here

# Session lifetime (Go duration: "720h" = 30 days)
SESSION_TOKEN_EXPIRY=720h

# Minimum time between score submissions per player (Go duration)
SCORE_COOLDOWN=1m

# Max auth requests per IP per minute
AUTH_RATE_LIMIT=10
